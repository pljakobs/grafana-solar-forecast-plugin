{
  "name": "solar-forecast-datasource",
  "version": "1.0.2",
  "description": "Grafana data source plugin for solar power forecasts from Forecast.Solar and Solcast",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix",
    "clean": "rm -rf dist/",
    "package": "npm run build && npm run package:plugin",
    "package:plugin": "mkdir -p release/solar-forecast-datasource && cp -r dist/* release/solar-forecast-datasource/ && cp plugin.json README.md LICENSE CHANGELOG.md release/solar-forecast-datasource/ && cd release && zip -r ../solar-forecast-datasource-v1.0.1.zip solar-forecast-datasource/",
    "serve": "webpack serve --mode development",
    "version": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-repo/solar-forecast-datasource.git"
  },
  "bugs": {
    "url": "https://github.com/your-repo/solar-forecast-datasource/issues"
  },
  "homepage": "https://github.com/your-repo/solar-forecast-datasource#readme",
  "author": "Solar Forecast Plugin Contributors",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/data": "^13.2.0",
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/runtime": "^13.2.0",
    "@grafana/tsconfig": "^2.2.0",
    "@grafana/ui": "^13.2.0",
    "@swc/core": "^1.16.1",
    "@swc/helpers": "^0.5.23",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "ajv": "^8.20.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^6.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "identity-obj-proxy": "^3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "^1.103.1",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "webpack": "^5.110.0",
    "webpack-cli": "^7.2.2",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.2.0-rc.1",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "grafana",
    "plugin",
    "datasource",
    "solar",
    "forecast",
    "renewable",
    "energy",
    "forecast.solar",
    "solcast",
    "photovoltaic",
    "pv"
  ],
  "grafana": {
    "id": "solar-forecast-datasource",
    "type": "datasource",
    "version": "1.0.1"
  }
}
