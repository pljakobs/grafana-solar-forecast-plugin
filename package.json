{
  "name": "solar-forecast-datasource",
  "version": "1.0.1",
  "description": "Grafana data source plugin for solar power forecasts from Forecast.Solar and Solcast",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "npm run lint -- --fix",
    "clean": "rm -rf dist/",
    "package": "npm run build && npm run package:plugin",
    "package:plugin": "mkdir -p release/solar-forecast-datasource && cp -r dist/* release/solar-forecast-datasource/ && cp plugin.json README-RELEASE.md LICENSE CHANGELOG.md release/solar-forecast-datasource/ && cd release && zip -r ../solar-forecast-datasource.zip solar-forecast-datasource/",
    "serve": "webpack serve --mode development",
    "version": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-repo/solar-forecast-datasource.git"
  },
  "bugs": {
    "url": "https://github.com/your-repo/solar-forecast-datasource/issues"
  },
  "homepage": "https://github.com/your-repo/solar-forecast-datasource#readme",
  "author": "Solar Forecast Plugin Contributors",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/data": "^13.2.0",
    "@grafana/runtime": "^13.2.0",
    "@grafana/ui": "^13.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "ajv": "^8.20.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "typescript": "^5.6.3",
    "webpack": "^5.110.0",
    "webpack-cli": "^7.2.2"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "grafana",
    "plugin",
    "datasource",
    "solar",
    "forecast",
    "renewable",
    "energy",
    "forecast.solar",
    "solcast",
    "photovoltaic",
    "pv"
  ],
  "grafana": {
    "id": "solar-forecast-datasource",
    "type": "datasource",
    "version": "1.0.1"
  }
}
